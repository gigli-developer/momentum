# Copiá este archivo a .env.local y completá los valores.
# .env.local está ignorado por git.

# Panel de Supabase → Project Settings → Data API
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Panel de Supabase → Project Settings → API Keys → anon / public
# Es pública por diseño: lo que protege los datos es RLS.
VITE_SUPABASE_ANON_KEY=

# NUNCA pongas acá la service_role key. Saltea RLS por completo.
